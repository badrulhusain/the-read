{
  "name": "the-read",
  "version": "1.0.0",
  "private": true,
  "description": "The Read frontend and API in one Next.js deployment",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build:backend && next dev --webpack",
    "build": "npm run build:backend && next build --webpack",
    "build:backend": "npm run build --workspace @the-read/backend",
    "start": "next start",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @the-read/backend",
    "lint": "eslint src/client pages && npm run lint --workspace @the-read/backend",
    "test": "npm run test --workspace @the-read/backend -- --runInBand",
    "test:smoke": "tsx scripts/smoke.ts",
    "db:generate": "npm run db:generate --workspace @the-read/backend",
    "db:migrate": "npm run db:migrate --workspace @the-read/backend",
    "db:seed": "npm run seed --workspace @the-read/backend",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@tiptap/extension-link": "3.25.0",
    "@tiptap/extension-placeholder": "3.25.0",
    "@tiptap/extension-text-align": "3.25.0",
    "@tiptap/extension-underline": "3.25.0",
    "@tiptap/react": "3.25.0",
    "@tiptap/starter-kit": "3.25.0",
    "axios": "1.13.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.10",
    "lucide-react": "0.575.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "6.0.2",
    "react-hot-toast": "2.6.0",
    "react-router-dom": "7.13.1",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.1",
    "next": "16.4.3",
    "@the-read/backend": "*"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/node": "24.11.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "@tailwindcss/postcss": "4.2.1",
    "tsx": "4.20.6"
  },
  "overrides": {
    "@tiptap/core": "3.25.0",
    "@tiptap/extension-blockquote": "3.25.0",
    "@tiptap/extension-bold": "3.25.0",
    "@tiptap/extension-bubble-menu": "3.25.0",
    "@tiptap/extension-bullet-list": "3.25.0",
    "@tiptap/extension-code": "3.25.0",
    "@tiptap/extension-code-block": "3.25.0",
    "@tiptap/extension-document": "3.25.0",
    "@tiptap/extension-dropcursor": "3.25.0",
    "@tiptap/extension-floating-menu": "3.25.0",
    "@tiptap/extension-gapcursor": "3.25.0",
    "@tiptap/extension-hard-break": "3.25.0",
    "@tiptap/extension-heading": "3.25.0",
    "@tiptap/extension-horizontal-rule": "3.25.0",
    "@tiptap/extension-italic": "3.25.0",
    "@tiptap/extension-link": "3.25.0",
    "@tiptap/extension-list": "3.25.0",
    "@tiptap/extension-list-item": "3.25.0",
    "@tiptap/extension-list-keymap": "3.25.0",
    "@tiptap/extension-ordered-list": "3.25.0",
    "@tiptap/extension-paragraph": "3.25.0",
    "@tiptap/extension-placeholder": "3.25.0",
    "@tiptap/extension-strike": "3.25.0",
    "@tiptap/extension-text": "3.25.0",
    "@tiptap/extension-text-align": "3.25.0",
    "@tiptap/extension-underline": "3.25.0",
    "@tiptap/extensions": "3.25.0",
    "@tiptap/pm": "3.25.0",
    "@tiptap/react": "3.25.0",
    "@tiptap/starter-kit": "3.25.0"
  }
}
